# Public Supabase values (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only Supabase credential. Never expose or commit this value.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# News generation. Gemini is primary; Groq is the fallback.
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Daily Boost wellness content
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional article search enhancement. The app still uses RSS without this key.
GNEWS_API_KEY=your_gnews_api_key

# Push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com

# Protects the scheduled cron route and its internal workers.
CRON_SECRET=use_a_long_random_secret

# Optional. Set to false only while debugging cron work inline.
CRON_FANOUT=true
